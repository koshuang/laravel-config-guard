{
  "name": "koshuang/laravel-config-guard",
  "description": "Guardrails for Laravel configuration contracts.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Koshuang\\LaravelConfigGuard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Koshuang\\LaravelConfigGuard\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Koshuang\\LaravelConfigGuard\\ConfigGuardServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
